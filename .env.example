# Neon Postgres - use the POOLED connection string from the Neon console
# (Dashboard > your project > Connection Details > "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full"

# Direct (non-pooled) connection - same host without "-pooler".
# Prisma migrations need a session-mode connection; PgBouncer transaction mode
# cannot hold the advisory locks migrate uses.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full"

# Session signing secret - generate with: openssl rand -base64 32
SESSION_SECRET=""

# Email (OTP + notifications). Leave RESEND_API_KEY empty in dev to print OTPs to the console.
RESEND_API_KEY=""
MAIL_FROM="ANAID Quality Disposables <noreply@anaid.co.uk>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"




# No verified sending domain yet, so every OTP is pinned to this value and no
# email is sent. Delete this line once a real sending domain is verified.
OTP_FIXED_CODE="1234"
